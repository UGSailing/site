FROM node:24-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl curl bash bash-completion \
 && rm -rf /var/lib/apt/lists/* \
 && printf 'PS1="[dev] %s \\$ "\n[ -f /etc/bash_completion ] && . /etc/bash_completion\n' '\w' > /root/.bashrc

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

RUN corepack enable pnpm