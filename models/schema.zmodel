/// Prisma schema file -*-js-*-

/// Database connection configuration
datasource db {
    provider          = "postgresql"
    url               = env("DATABASE_URL")
    shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Prisma Client generator configuration
generator client {
    provider = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

plugin openapi {
    provider = "@zenstackhq/openapi"
    output = "../public/api/openapi.json"
    flavor = "rest"
    title = "UGent Sailing site API"
    version = "1.0.0"
    prefix = "/api/model/rest"
}

///////////////////
/// Auth models ///
///////////////////
model Account {
    id                String  @id @default(cuid())
    userId            String  @map("user_id")
    type              String
    provider          String
    providerAccountId String  @map("provider_account_id")
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@map("accounts")

    @@allow('read', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique @map("session_token")
    userId       String   @map("user_id")
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("sessions")

    @@allow('read', auth().roles?[role.name == "Web"])
}

model User {
    id            String     @id @default(cuid())
    name          String?
    email         String?    @unique
    emailVerified DateTime?  @map("email_verified")
    image         String?
    accounts      Account[]
    sessions      Session[]

    partner_id    Int?       @map("partner_id")
    partner       Partner?   @relation(fields: [partner_id], references: [id], onDelete: SetNull)

    roles         UserRole[]
    uploadedMedia Media[]

    @@map("users")

    @@allow('read,update', auth() == this || auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")

    @@allow('read', auth().roles?[role.name == "Web"])
}

///////////////////
/// Permissions ///
///////////////////

model Role {
    id    BigInt     @id
    name  String     @unique
    users UserRole[]
    @@map("roles")

    @@allow('read', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model UserRole {
    id     Int    @id @default(autoincrement())
    userId String @map("user_id")
    roleId BigInt @map("role_id")

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userId, roleId])
    @@map("user_roles")

    @@allow('read,create,update', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

abstract model TimestampBase {
    createdAt DateTime @default(now()) @map("created_at") @deny('update', true) @meta("zod", "omit()")
    updatedAt DateTime @updatedAt @map("updated_at") @deny('update', true)

    @@allow('read', auth().roles?[role.name == "Web" || role.name == "Captain"])
}

////////////////////
/// Media models ///
////////////////////
model Media extends TimestampBase {
    id            String        @id @unique
    filename      String        @trim
    filepath      String        @trim @unique
    mimetype      String        @trim
    size          Int           @gte(0)

    // Image metadata
    width         Int?          @gte(0)
    height        Int?          @gte(0)

    // Uploader
    uploadedById  String?       @map("uploaded_by_id")
    uploadedBy    User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

    events        Event[]
    board_members BoardMemberYear[]
    partners      Partner[]

    @@map("media")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}


//////////////////
/// App models ///
//////////////////
model Event extends TimestampBase {
    id           Int      @unique @id @default(autoincrement())
    title        String   @trim
    startDate    DateTime
    endDate      DateTime
    location     String
    intro        String
    description  String?  @trim
    registration Int?     @gte(0)

    imageId      String?  @map("image_id")
    image        Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)

    @@validate(startDate < endDate, "Event startDate must be before endDate")

    @@map("events")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model Position extends TimestampBase {
    id           Int                   @id @default(autoincrement())
    name         String                @trim @unique
    description  String                @trim
    email        String?               @trim
    index        Int                   @default(10) @gte(0)

    boardmembers BoardMemberPosition[]

    @@map("positions")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model BoardMember extends TimestampBase {
    id        Int                @id @default(autoincrement())
    name      String                @trim

    years     BoardMemberYear[]

    @@map("boardmembers")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model Board extends TimestampBase {
    id      Int               @id @default(autoincrement())
    year    Int               @unique
    name    String            @trim
    members BoardMemberYear[]

    @@map("boards")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model BoardMemberYear extends TimestampBase {
    id            Int                   @id @default(autoincrement())
    imageId       String?               @map("media_id")
    boardMemberId Int                   @map("boardmember_id")
    boardId       Int                   @map("board_id")
    index         Int                   @default(10) @gte(0)

    boardmember   BoardMember           @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)
    board         Board                 @relation(fields: [boardId], references: [id], onDelete: Cascade)
    positions     BoardMemberPosition[]
    image         Media?                @relation(fields: [imageId], references: [id], onDelete: SetNull)

    @@unique([boardMemberId, boardId])
    @@map("boardmember_year")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model BoardMemberPosition extends TimestampBase {
    id                Int             @id @default(autoincrement())
    positionId        Int             @map("position_id")
    boardMemberYearId Int             @map("boardmember_year_id")

    boardmember       BoardMemberYear @relation(fields: [boardMemberYearId], references: [id], onDelete: Cascade)
    position          Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)

    @@unique([boardMemberYearId, positionId])
    @@map("boardmember_position")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

enum PartnerType {
    NAME
    HEAD
    STRATEGIC
    COLLABORATIVE
}

model Partner extends TimestampBase {
    id          Int       @id @default(autoincrement())
    name        String    @trim
    active      Boolean   @default(true)
    url         String    @trim
    description String?

    partnerType PartnerType @default(COLLABORATIVE) @map("partner_type")

    logoId      String?   @map("logo_id")
    logo        Media?    @relation(fields: [logoId], references: [id], onDelete: SetNull)

    users       User[]
    vacancies   Vacancy[]

    @@map("partners")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model Vacancy extends TimestampBase {
    id          Int     @id @default(autoincrement())
    title       String  @trim
    description String? @trim
    url         String  @trim

    partnerId   Int     @map("partner_id")
    partner     Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

    @@map("vacancies")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}

model News extends TimestampBase {
    id    Int    @unique @id @default(autoincrement())
    title String @trim
    link  String @trim

    @@map("news")

    @@allow('read', true)
    @@allow('create,update', auth().roles?[role.name == "Captain" || role.name == "Web" || role.name == "Team"])
    @@allow('delete', auth().roles?[role.name == "Captain" || role.name == "Web"])
}